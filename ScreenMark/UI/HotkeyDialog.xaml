<Window x:Class="ScreenMark.UI.HotkeyDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenMark hotkey"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#202124"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="0,7" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="#3C4043" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#8AB4F8" />
                                <Setter Property="Foreground" Value="#202124" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock x:Name="Message" Foreground="#F28B82" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
        <TextBlock Text="Press the shortcut you want to use" Foreground="#E8EAED" FontSize="14" />
        <Border Background="#2B2C30" CornerRadius="8" Padding="12" Margin="0,12">
            <TextBlock x:Name="Shortcut" Text="Press keys…" Foreground="#9AA0A6" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </Border>
        <TextBlock Text="Combine Ctrl, Alt or Win with another key." Foreground="#9AA0A6" FontSize="12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Save" IsDefault="True" IsEnabled="False" Click="OnSaveClick" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
